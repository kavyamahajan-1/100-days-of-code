/*Q52: Write a program to print the following pattern:

*

*
*
*

*
*
*
*
*

*
*
*

*



Sample Test Cases:
Input 1:

Output 1:
Pattern with stars spaced irregularly as shown.

*/


#include <stdio.h>

int main() {
    int groups = 5;
    int i, j, starsInGroup;

    for (i = 1; i <= groups; i++) {
    
        if (i == 1) starsInGroup = 1;
        else if (i == 2) starsInGroup = 3;
        else if (i == 3) starsInGroup = 5;
        else if (i == 4) starsInGroup = 3;
        else starsInGroup = 1;

        for (j = 1; j <= starsInGroup; j++) {
            printf("*\n");
        }
        printf("\n"); 
    }

    return 0;
}
