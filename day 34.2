/*Q68: Delete an element from an array.


Sample Test Cases:
Input 1:
5
1 2 3 4 5
2
Output 1:
1 2 4 5

*/

#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    int pos;
    scanf("%d", &pos);

    // Shift elements to the left from pos+1 to n-1
    for (int i = pos; i < n - 1; i++)
        arr[i] = arr[i + 1];

    // Print result (n-1 elements now)
    for (int i = 0; i < n - 1; i++)
        printf("%d ", arr[i]);
    printf("\n");

    return 0;
}
