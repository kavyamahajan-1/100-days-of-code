/*Q132: Define an enum for traffic lights (RED, YELLOW, GREEN) and print 'Stop', 'Wait', or 'Go' based on its value.


Sample Test Cases:
Input 1:
GREEN
Output 1:
Go

*/

#include <stdio.h>
#include <string.h>

enum Light { RED, YELLOW, GREEN };

int main() {
    char input[20];
    enum Light signal;

    // Read the color name
    scanf("%s", input);

    // Convert the input text to the matching enum value
    if (strcmp(input, "RED") == 0) {
        signal = RED;
    } else if (strcmp(input, "YELLOW") == 0) {
        signal = YELLOW;
    } else if (strcmp(input, "GREEN") == 0) {
        signal = GREEN;
    } else {
        printf("Invalid signal\n");
        return 0;
    }

    // Print the action based on the enum value
    switch (signal) {
        case RED:
            printf("Stop\n");
            break;
        case YELLOW:
            printf("Wait\n");
            break;
        case GREEN:
            printf("Go\n");
            break;
    }

    return 0;
}
