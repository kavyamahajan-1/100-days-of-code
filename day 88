/*Q138: Print all enum names and integer values using a loop.


Sample Test Cases:
Input 1:
No input
Output 1:
RED=0
YELLOW=1
GREEN=2

*/


#include <stdio.h>

enum Light { RED, YELLOW, GREEN };

int main() {
    // C cannot print an enum's name automatically,
    // so the names are kept in an array in the same order as the enum
    const char *names[] = {"RED", "YELLOW", "GREEN"};

    for (int i = RED; i <= GREEN; i++) {
        printf("%s=%d\n", names[i], i);
    }

    return 0;
}
