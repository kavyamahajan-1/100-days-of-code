/*Q79: Perform diagonal traversal of a matrix.


Sample Test Cases:
Input 1:
3 3
1 2 3
4 5 6
7 8 9
Output 1:
1 2 4 7 5 3 6 8 9

*/

#include <stdio.h>

int main() {
    int r, c;
    int a[100][100];

    scanf("%d %d", &r, &c);

    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            scanf("%d", &a[i][j]);

    int total_diagonals = r + c - 1;

    for (int d = 0; d < total_diagonals; d++) {
        int row_start = (d - c + 1) > 0 ? (d - c + 1) : 0;
        int row_end = (d < r - 1) ? d : r - 1;

        if (d % 2 == 0) {
            for (int i = row_end; i >= row_start; i--) {
                int j = d - i;
                printf("%d", a[i][j]);
                printf(" ");
            }
        } else {
            for (int i = row_start; i <= row_end; i++) {
                int j = d - i;
                printf("%d", a[i][j]);
                printf(" ");
            }
        }
    }
    printf("\n");

    return 0;
}
