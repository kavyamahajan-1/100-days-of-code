//Q16: Write a program to input three numbers and find the largest among them using if–else.

/*
Sample Test Cases:
Input 1:
3 7 5
Output 1:
Largest is 7

Input 2:
-1 -5 0
Output 2:
Largest is 0

*/

#include <stdio.h>
int main() {
    int no1, no2, no3;
    printf("Enter three numbers: ");
    scanf("%d %d %d", &no1, &no2, &no3);
    
    if (no1 >= no2 && no1 >= no3)
     {
        printf("Largest is %d\n", no1);
    } 
    else if (no2 >= no1 && no2 >= no3)
     {
        printf("Largest is %d\n", no2   );
    } 
    else {
        printf("Largest is %d\n", no3     );
    }
    
    return 0;
}
