/*Q63: Merge two arrays.


Sample Test Cases:
Input 1:
3
1 2 3
2
4 5
Output 1:
1 2 3 4 5

*/

#include <stdio.h>

int main() {
    int n, m;
    int a[1000], b[1000], merged[2000];

    scanf("%d", &n);
    for (int i = 0; i < n; i++) scanf("%d", &a[i]);

    scanf("%d", &m);
    for (int i = 0; i < m; i++) scanf("%d", &b[i]);

    int i = 0, j = 0, k = 0;

    while (i < n && j < m) {
        if (a[i] <= b[j])
            merged[k++] = a[i++];
        else
            merged[k++] = b[j++];
    }
    while (i < n) merged[k++] = a[i++];
    while (j < m) merged[k++] = b[j++];

    for (int x = 0; x < k; x++) {
        printf("%d", merged[x]);
        if (x != k - 1) printf(" ");
    }
    printf("\n");

    return 0;
}
