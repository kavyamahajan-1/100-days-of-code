/*Q114: Write a program to take a string s as input. The task is to find the length of the longest substring without repeating characters. Print the length as output.


Sample Test Cases:
Input 1:
s = "abcabcbb"
Output 1:
3

Input 2:
s = "bbbbb"
Output 2:
1

Input 3:
s = "pwwkew"
Output 3:
3

*/

#include <stdio.h>

int main() {
    char str[1000];
    int last[256]; // last seen index of each character

    fgets(str, sizeof(str), stdin);

    for (int i = 0; i < 256; i++) {
        last[i] = -1;
    }

    int start = 0;   // start of the current window
    int maxLen = 0;

    for (int i = 0; str[i] != '\0' && str[i] != '\n'; i++) {
        unsigned char ch = str[i];

        // if ch was seen inside the current window, move start past it
        if (last[ch] >= start) {
            start = last[ch] + 1;
        }

        last[ch] = i;

        int windowLen = i - start + 1;
        if (windowLen > maxLen) {
            maxLen = windowLen;
        }
    }

    printf("%d\n", maxLen);

    return 0;
}
