/*Q145: Return a structure containing top student's details from a function.


Sample Test Cases:
Input 1:
3 students: Riya 101 89, Karan 102 96, Meena 103 92
Output 1:
Top Student: Karan | Roll: 102 | Marks: 96

*/

#include <stdio.h>

struct Student {
    char name[50];
    int roll_no;
    int marks;
};

// Function that returns a structure: the student with the highest marks
struct Student findTop(struct Student s[], int n) {
    struct Student top = s[0];

    for (int i = 1; i < n; i++) {
        if (s[i].marks > top.marks) {
            top = s[i];
        }
    }

    return top;
}

int main() {
    int n;
    struct Student s[100];

    // Read number of students
    scanf("%d", &n);

    // Read each student's name, roll number and marks
    for (int i = 0; i < n; i++) {
        scanf("%s %d %d", s[i].name, &s[i].roll_no, &s[i].marks);
    }

    // The function returns a whole structure, stored in another structure variable
    struct Student best = findTop(s, n);

    printf("Top Student: %s | Roll: %d | Marks: %d\n", best.name, best.roll_no, best.marks);

    return 0;
}
